# Deployment settings. Copy to settings.toml and edit; every key is optional
# and falls back to the default shown here. These are knobs whose wrong value
# can stop the app running or make it unreachable. Settings that are just data
# (e.g. the shop title) are edited on the app's Settings page instead.

[db]
# The .sql next to this path is the source of truth (keep its folder in git);
# the .db itself is a working copy, rebuilt from the .sql on every startup.
db_path = "inventory.db"

[gui]
port = 8080

[logging]
level = "DEBUG"        # DEBUG, INFO, WARNING or ERROR
file = "log.txt"       # writes are logged here (INFO), failures at ERROR
rollover_kb = 100      # start a new file (log.txt.1, ...) after this many KB
max_total_kb = 400     # once the total exceeds this, the oldest file is deleted
