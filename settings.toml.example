# Deployment settings. Copy to settings.toml and edit, then name it when
# starting the app: `uv run backend/main.py settings.toml`. Relative paths
# below are resolved against THIS file's directory, so the settings file can
# sit next to your data. Every key is optional and falls back to the default
# shown here. These are knobs whose wrong value can stop the app running or
# make it unreachable. Settings that are just data (e.g. the shop title) are
# edited on the app's Settings page instead.

[db]
# Your data: a folder of readable SQL, one file per table (parts.sql,
# stock_items.sql, ...). This is the thing to keep in git -- each change
# rewrites only the tables it touched, so a diff shows what actually happened.
# SQLite is an internal detail: a working copy is rebuilt from these files in a
# temp directory every time the app starts, so there is no database path to
# configure. The folder is created if it does not exist.
#
# Upgrading from a single inventory.sql? Leave this pointing at that file. It
# is read once and rewritten as a folder of the same name beside it; your
# original file is left untouched and can be deleted afterwards.
data_path = "data"

# Commit the data after every change, using the activity-log entry as the
# commit message. Does nothing if the data folder is not a git repository;
# refused at startup if the data lives inside the Stronghold app folder.
auto_commit = false

[gui]
port = 8080

[secrets]
# Credentials (the WooCommerce key and secret) are entered on the app's
# Settings page and stored encrypted in the data (settings.sql). This is the
# key that decrypts them, created automatically on first run.
#
# Do NOT commit it -- it is the one file that makes those encrypted values
# readable. Back it up separately from your data. If you lose it, the app still
# runs; you just re-enter the credentials it could no longer read.
key_file = "secrets.key"

[logging]
level = "DEBUG"        # DEBUG, INFO, WARNING or ERROR
file = "log.txt"       # writes are logged here (INFO), failures at ERROR
rollover_kb = 100      # start a new file (log.txt.1, ...) after this many KB
max_total_kb = 400     # once the total exceeds this, the oldest file is deleted
